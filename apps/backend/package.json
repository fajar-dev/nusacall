{
  "name": "@nusacall/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint 'src/**/*.{ts,js}' --ignore-pattern '**/Invalid*.ts'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.config.int.ts",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "tsx node_modules/typeorm/cli.js migration:run -d src/infrastructure/database/data-source.ts",
    "migration:revert": "tsx node_modules/typeorm/cli.js migration:revert -d src/infrastructure/database/data-source.ts",
    "migration:generate": "tsx node_modules/typeorm/cli.js migration:generate -d src/infrastructure/database/data-source.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.620.0",
    "@aws-sdk/s3-request-presigner": "^3.620.0",
    "@hono/node-server": "^1.12.0",
    "@hono/zod-openapi": "^0.16.0",
    "@nusacall/contracts": "workspace:*",
    "@nusacall/ws-protocol": "workspace:*",
    "@scalar/hono-api-reference": "^0.5.0",
    "argon2": "^0.45.1",
    "bullmq": "^5.12.0",
    "hono": "^4.5.0",
    "ioredis": "^5.4.0",
    "jose": "^6.2.8",
    "mysql2": "^3.11.0",
    "otplib": "^13.4.1",
    "pino": "^9.3.0",
    "pino-pretty": "^11.2.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "ulid": "^3.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nusacall/eslint-config": "workspace:*",
    "@testcontainers/mysql": "^10.11.0",
    "@testcontainers/redis": "^10.11.0",
    "@types/ioredis-mock": "^8.2.8",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "eslint": "^8.57.0",
    "ioredis-mock": "^8.13.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
